# true : données fictives en mémoire, aucun backend nécessaire
#        (n'importe quel mot de passe est accepté)
# false : appels au backend FastAPI réel
VITE_USE_MOCK=true

# URL de l'API vue par le navigateur. Par défaut /api, relayé par Vite
# vers VITE_PROXY_TARGET (évite les problèmes CORS en développement).
VITE_API_URL=/api

# Adresse du backend FastAPI (utilisée par le relais de Vite)
VITE_PROXY_TARGET=http://localhost:8000

# Intervalle de rafraîchissement automatique, en millisecondes
VITE_POLLING_MS=30000
